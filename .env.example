# ---------------------------------------------------------------------------
# Nova server configuration — copy this file to ".env" and fill in real values.
# NEVER commit ".env" to git.
# ---------------------------------------------------------------------------

# Nova's brain (Google Gemini). Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_CODING_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

PORT=3000
MAX_UPLOAD_MB=15

# Session / login security — set this to a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# Real usage accounting — the ⚡ bar at the top is based on this, not a fake countdown.
# Tokens are counted from Gemini's own usage metadata for each request.
# Raise/lower this to fit how much you want each account to be able to use per day.
DAILY_TOKEN_QUOTA=200000
IMAGE_TOKEN_COST=2500

# ---------------------------------------------------------------------------
# OPTIONAL but STRONGLY recommended if you deploy on Render's free plan (or
# any host with an ephemeral/non-persistent disk).
#
# Accounts are stored in a local file (data/nova.json). Free hosting plans
# wipe the local disk every time the instance restarts or wakes up from
# sleep — so every registered account quietly disappears, and login stops
# working for accounts that worked fine minutes earlier.
#
# Fix: create a free database at https://upstash.com (Redis, free tier is
# plenty), then paste its REST URL + token below. Nova will automatically
# back up the whole account database there on every save, and restore it
# the moment the server boots — so accounts survive restarts. Leave these
# blank and nothing changes (pure local file, fine for local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
